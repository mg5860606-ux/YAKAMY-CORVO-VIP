# =============================================
# 🩷 YAKAMY VIP — Configuração do Bot
# =============================================
# Copie este arquivo para .env e preencha com suas chaves
# cp .env.example .env
# =============================================

# 🔑 Chaves do Google Gemini (obrigatório)
# Crie sua chave em: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=sua_chave_aqui
GEMINI_API_KEY=sua_chave_aqui
GEMINI_API_KEY_2=sua_segunda_chave_aqui

# 🤖 Modelos Gemini
GOOGLE_GEMINI_MODEL=models/gemini-2.5-flash
GOOGLE_GEMINI_MODEL_SECONDARY=models/gemini-2.5-pro
IA_MODEL_PRIMARY=models/gemini-2.5-flash
IA_MODEL_SECONDARY=models/gemini-2.5-pro

